# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project Settings > Environment Variables.

# Email delivery through Resend (https://resend.com). The FROM address must be on a
# domain verified in Resend, for example website@vantremont.com.
RESEND_API_KEY=
FORMS_FROM_EMAIL="Vantremont Website <website@vantremont.com>"

# Inboxes. Separate several addresses with commas.
CONTACT_TO_EMAIL=
RFP_TO_EMAIL=
CAREERS_TO_EMAIL=
NETWORK_TO_EMAIL=

# Cloudflare Turnstile spam protection (Cloudflare dashboard > Turnstile).
# For local testing you can use Cloudflare's always-pass test keys:
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
